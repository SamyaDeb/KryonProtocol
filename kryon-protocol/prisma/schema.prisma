// Kryon on Arc: persistence baseline (plan §9, roadmap Phase 2).
//
// Conventions (enforced by CHECK constraints in the baseline migration, which
// Prisma cannot express):
//   - network is "arc-mainnet" | "arc-testnet" | "arc-local".
//   - Addresses are lowercase 0x + 40 hex; bytes32 values are lowercase 0x + 64 hex.
//   - On-chain integers are stored exactly as emitted, in NUMERIC(78,0), which
//     holds every uint256/int256. Each column documents its unit:
//       1e18 = protocol internal ledger / price / size / funding index
//       1e6  = USDC token units (ERC-20 interface)
//   - Every row derived from a log carries (blockNumber, txHash, logIndex).
//     Arc finality is deterministic on inclusion, so there is no reorg handling;
//     blockHash is kept on the cursor as a consistency check only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors `TxJobStatus` in client/lib/chain/tx-store.ts.
enum TxJobStatus {
  PENDING
  SUBMITTED
  REPLACED
  CONFIRMED
  REVERTED
  DROPPED
  FAILED
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
}

enum FillStatus {
  /// Matched off-chain, batch not yet confirmed.
  PENDING
  /// `FillSettled` observed.
  SETTLED
  /// `FillRejected` observed, or the batch reverted.
  REJECTED
}

enum KeeperActionStatus {
  PLANNED
  SUBMITTED
  CONFIRMED
  FAILED
  SKIPPED
}

enum MonitorLevel {
  OK
  WARN
  PAGE
}

enum MonitorSeverity {
  PAGE
  WARN
}

enum MonitorAlertEvent {
  FIRING
  REMINDER
  RESOLVED
}

enum GovernanceOperationStatus {
  SCHEDULED
  EXECUTED
  CANCELLED
}

enum StatsPeriod {
  DAY
  WEEK
  MONTH
  ALL
}

enum PnlEventKind {
  REALIZED_TRADE
  FUNDING
  LIQUIDATION
  LIQUIDATION_PENALTY
  DELEVERAGE
  FEE
}

enum BalanceChangeKind {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

// ─────────────────────────────────────────────────────────────────────────────
//  INDEXING
// ─────────────────────────────────────────────────────────────────────────────

/// Last fully processed block per indexed stream. Updated in the same database
/// transaction as the rows derived from that block range.
model BlockCursor {
  network     String
  /// Contract address, or a named stream such as "all".
  stream      String
  blockNumber BigInt
  blockHash   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@id([network, stream])
}

/// Every decoded log from a Kryon contract, verbatim. Typed tables below are
/// projections of this one and can be rebuilt from it.
model ProtocolEvent {
  id             BigInt   @id @default(autoincrement())
  network        String
  blockNumber    BigInt
  blockHash      String
  blockTimestamp DateTime
  txHash         String
  logIndex       Int
  contract       String
  eventName      String
  topic0         String
  /// Decoded arguments; bigint values are encoded as decimal strings.
  args           Json
  createdAt      DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, blockNumber, logIndex])
  @@index([network, eventName, blockNumber])
  @@index([contract])
}

// ─────────────────────────────────────────────────────────────────────────────
//  MARKETS, ACCOUNTS, ORDERS, FILLS, POSITIONS
// ─────────────────────────────────────────────────────────────────────────────

model Market {
  network           String
  /// On-chain uint32 marketId.
  id                Int
  symbol            String
  /// bytes32 OracleAdapter feed id.
  oracleId          String
  active            Boolean  @default(false)
  /// Last `MarketParamsSet` payload, decoded.
  params            Json     @default("{}")
  /// Per-market fee rates as emitted by `MarketFeesSet` (signed, rate units).
  makerRate         Int      @default(0)
  takerRate         Int      @default(0)
  lastMark          Decimal  @default(0) @db.Decimal(78, 0) // 1e18
  lastIndex         Decimal  @default(0) @db.Decimal(78, 0) // 1e18
  longFundingIndex  Decimal  @default(0) @db.Decimal(78, 0) // 1e18
  shortFundingIndex Decimal  @default(0) @db.Decimal(78, 0) // 1e18
  fundingRatePerHour Decimal @default(0) @db.Decimal(78, 0) // 1e18
  longOpenInterest  Decimal  @default(0) @db.Decimal(78, 0) // 1e18 size
  shortOpenInterest Decimal  @default(0) @db.Decimal(78, 0) // 1e18 size
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  orders         Order[]
  fills          Fill[]
  positions      Position[]
  fundingUpdates FundingUpdate[]

  @@id([network, id])
  @@unique([network, symbol])
}

model Account {
  network         String
  address         String
  /// Current tier from the latest `FeeTierSet`.
  feeTier         Int      @default(0)
  /// Orders with nonce below this are cancelled (`NoncesCancelledUpTo`).
  minValidNonce   Decimal  @default(0) @db.Decimal(78, 0)
  /// Vault ledger balance after the latest indexed change (1e18).
  ledgerBalance   Decimal  @default(0) @db.Decimal(78, 0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  orders    Order[]
  positions Position[]

  @@id([network, address])
}

/// A signed EIP-712 order accepted by the intake API.
model Order {
  /// EIP-712 digest, unique across networks (the domain includes chainId).
  orderHash   String      @id
  network     String
  owner       String
  marketId    Int
  isLong      Boolean
  size        Decimal     @db.Decimal(78, 0) // 1e18
  limitPrice  Decimal     @db.Decimal(78, 0) // 1e18
  reduceOnly  Boolean
  nonce       Decimal     @db.Decimal(78, 0)
  /// Unix seconds (uint64).
  expiry      BigInt
  /// null when the order's referrer is address(0).
  referrer    String?
  /// 0x-hex signature (65-byte ECDSA, or ERC-1271 bytes).
  signature   String
  status      OrderStatus @default(OPEN)
  filledSize  Decimal     @default(0) @db.Decimal(78, 0) // 1e18
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  account Account @relation(fields: [network, owner], references: [network, address])
  // RESTRICT: de-listing a market must never delete order history.
  market  Market  @relation(fields: [network, marketId], references: [network, id], onDelete: Restrict)

  // Nonces are global per account, not per market.
  @@unique([network, owner, nonce])
  @@index([network, marketId, status, isLong, limitPrice])
  @@index([network, status, expiry])
}

/// One matched fill. Created PENDING by the matcher, finalised by the indexer.
model Fill {
  id             BigInt     @id @default(autoincrement())
  network        String
  /// bytes32 fill id committed in the batch.
  fillId         String
  status         FillStatus @default(PENDING)
  /// Decoded revert reason from `FillRejected`.
  rejectReason   String?
  marketId       Int
  maker          String
  taker          String
  makerOrderHash String
  takerOrderHash String
  takerIsBuy     Boolean
  size           Decimal    @db.Decimal(78, 0) // 1e18
  price          Decimal    @db.Decimal(78, 0) // 1e18
  makerFee       Decimal    @default(0) @db.Decimal(78, 0) // 1e18, signed (negative = rebate)
  takerFee       Decimal    @default(0) @db.Decimal(78, 0) // 1e18
  makerTier      Int        @default(0)
  takerTier      Int        @default(0)
  /// The TxJob that carried the batch.
  txJobId        String?
  blockNumber    BigInt?
  txHash         String?
  logIndex       Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  market Market @relation(fields: [network, marketId], references: [network, id])

  @@unique([network, fillId])
  @@unique([network, txHash, logIndex])
  @@index([network, marketId, blockNumber])
  @@index([network, status, createdAt])
  @@index([network, maker, createdAt])
  @@index([network, taker, createdAt])
}

/// Current position, projected from `PositionChanged` (one per trader/market).
model Position {
  network         String
  trader          String
  marketId        Int
  size            Decimal  @db.Decimal(78, 0) // 1e18, signed (negative = short)
  openNotional    Decimal  @db.Decimal(78, 0) // 1e18
  lastPrice       Decimal  @db.Decimal(78, 0) // 1e18
  realizedPnlCum  Decimal  @default(0) @db.Decimal(78, 0) // 1e18
  /// Ordering key of the last applied event, so replays are idempotent.
  lastBlockNumber BigInt
  lastLogIndex    Int
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  account Account @relation(fields: [network, trader], references: [network, address])
  market  Market  @relation(fields: [network, marketId], references: [network, id])

  @@id([network, trader, marketId])
  @@index([network, marketId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  ORACLE, FUNDING, LIQUIDATION
// ─────────────────────────────────────────────────────────────────────────────

/// `PriceUpdated` from OracleAdapter.
model OracleSnapshot {
  id          BigInt   @id @default(autoincrement())
  network     String
  oracleId    String
  price       Decimal  @db.Decimal(78, 0) // 1e18
  confidence  Decimal  @db.Decimal(78, 0) // 1e18
  publishTime BigInt
  writeTime   BigInt
  sourceCount Int
  blockNumber BigInt
  txHash      String
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, oracleId, publishTime])
}

/// `FundingUpdated` from Engine.
model FundingUpdate {
  id          BigInt   @id @default(autoincrement())
  network     String
  marketId    Int
  longIndex   Decimal  @db.Decimal(78, 0) // 1e18
  shortIndex  Decimal  @db.Decimal(78, 0) // 1e18
  ratePerHour Decimal  @db.Decimal(78, 0) // 1e18
  premium     Decimal  @db.Decimal(78, 0) // 1e18
  mark        Decimal  @db.Decimal(78, 0) // 1e18
  index       Decimal  @db.Decimal(78, 0) // 1e18
  blockNumber BigInt
  txHash      String
  logIndex    Int
  createdAt   DateTime @default(now())

  market Market @relation(fields: [network, marketId], references: [network, id])

  @@unique([network, txHash, logIndex])
  @@index([network, marketId, blockNumber])
}

/// `FundingSettled` from Engine: one account's payment.
model FundingPayment {
  id          BigInt   @id @default(autoincrement())
  network     String
  address     String
  marketId    Int
  amount      Decimal  @db.Decimal(78, 0) // 1e18, signed (positive = received)
  blockNumber BigInt
  txHash      String
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, address, createdAt])
}

/// `Liquidated` from Liquidation.
model LiquidationEvent {
  id           BigInt   @id @default(autoincrement())
  network      String
  trader       String
  liquidator   String
  marketId     Int
  closeSize    Decimal  @db.Decimal(78, 0) // 1e18
  price        Decimal  @db.Decimal(78, 0) // 1e18
  realizedPnl  Decimal  @db.Decimal(78, 0) // 1e18
  penalty      Decimal  @db.Decimal(78, 0) // 1e18
  reward       Decimal  @db.Decimal(78, 0) // 1e18
  equityBefore Decimal  @db.Decimal(78, 0) // 1e18
  equityAfter  Decimal  @db.Decimal(78, 0) // 1e18
  blockNumber  BigInt
  txHash       String
  logIndex     Int
  createdAt    DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, trader, createdAt])
  @@index([network, marketId, blockNumber])
}

/// `Deleveraged` (ADL) from Liquidation.
model DeleverageEvent {
  id           BigInt   @id @default(autoincrement())
  network      String
  counterparty String
  keeper       String
  marketId     Int
  closeSize    Decimal  @db.Decimal(78, 0) // 1e18
  price        Decimal  @db.Decimal(78, 0) // 1e18
  realizedPnl  Decimal  @db.Decimal(78, 0) // 1e18
  haircut      Decimal  @db.Decimal(78, 0) // 1e18
  blockNumber  BigInt
  txHash       String
  logIndex     Int
  createdAt    DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, counterparty, createdAt])
}

/// `BackstopUnwound` from Insurance.
model BackstopUnwind {
  id          BigInt   @id @default(autoincrement())
  network     String
  marketId    Int
  size        Decimal  @db.Decimal(78, 0) // 1e18
  price       Decimal  @db.Decimal(78, 0) // 1e18
  notional    Decimal  @db.Decimal(78, 0) // 1e18
  dayTotal    Decimal  @db.Decimal(78, 0) // 1e18
  blockNumber BigInt
  txHash      String
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, marketId, blockNumber])
}

// ─────────────────────────────────────────────────────────────────────────────
//  FEES (plan §5.7)
// ─────────────────────────────────────────────────────────────────────────────

/// `FeeAccrued` from FeeRouter.
model FeeAccrual {
  id          BigInt   @id @default(autoincrement())
  network     String
  marketId    Int
  payer       String
  referrer    String?
  amount      Decimal  @db.Decimal(78, 0) // 1e18
  toTreasury  Decimal  @db.Decimal(78, 0) // 1e18
  toInsurance Decimal  @db.Decimal(78, 0) // 1e18
  toReferral  Decimal  @db.Decimal(78, 0) // 1e18
  blockNumber BigInt
  txHash      String
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, payer, createdAt])
  @@index([network, referrer, createdAt])
  @@index([network, marketId, blockNumber])
}

/// `FeeClaimed` from FeeRouter.
model FeeClaim {
  id             BigInt   @id @default(autoincrement())
  network        String
  /// bytes32 bucket id.
  bucket         String
  recipient      String
  amount         Decimal  @db.Decimal(78, 0) // 1e6 token
  internalAmount Decimal  @db.Decimal(78, 0) // 1e18
  blockNumber    BigInt
  txHash         String
  logIndex       Int
  createdAt      DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, bucket, createdAt])
}

/// `FeeTierSet` history; `Account.feeTier` holds the current value.
model FeeTierAssignment {
  id          BigInt   @id @default(autoincrement())
  network     String
  address     String
  tier        Int
  blockNumber BigInt
  txHash      String
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, address, blockNumber])
}

// ─────────────────────────────────────────────────────────────────────────────
//  TRANSACTIONS, KEEPERS, GAS
// ─────────────────────────────────────────────────────────────────────────────

/// One row per broadcast attempt; see client/lib/chain/tx-store.ts.
model TxJob {
  /// Generated by the TxSender.
  id                   String      @id
  network              String
  service              String
  label                String
  fromAddress          String
  toAddress            String
  nonce                Int
  data                 String
  value                Decimal     @db.Decimal(78, 0) // wei (18-dec native USDC)
  gasLimit             Decimal     @db.Decimal(78, 0)
  maxFeePerGas         Decimal     @db.Decimal(78, 0)
  maxPriorityFeePerGas Decimal     @db.Decimal(78, 0)
  rawTx                String
  submittedHash        String
  replacedByHash       String?
  status               TxJobStatus
  gasUsed              Decimal?    @db.Decimal(78, 0)
  effectiveGasPrice    Decimal?    @db.Decimal(78, 0)
  blockNumber          BigInt?
  error                String?
  createdAt            DateTime
  updatedAt            DateTime

  @@unique([network, submittedHash])
  @@index([network, fromAddress, nonce, createdAt])
  @@index([network, status, fromAddress])
}

model KeeperAction {
  id          BigInt             @id @default(autoincrement())
  network     String
  kind        String
  marketId    Int?
  account     String?
  payload     Json
  status      KeeperActionStatus @default(PLANNED)
  txJobId     String?
  blockNumber BigInt?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([network, kind, status])
  @@index([network, marketId])
}

/// Daily gas spend per service key (monitor: revenue vs gas).
model GasSpend {
  network     String
  day         DateTime @db.Date
  service     String
  fromAddress String
  txCount     Int      @default(0)
  gasUsed     Decimal  @default(0) @db.Decimal(78, 0)
  /// Sum of gasUsed × effectiveGasPrice, in wei of 18-decimal native USDC.
  costWei     Decimal  @default(0) @db.Decimal(78, 0)
  updatedAt   DateTime @updatedAt

  @@id([network, day, service, fromAddress])
}

// ─────────────────────────────────────────────────────────────────────────────
//  DEPLOYMENT AND GOVERNANCE
// ─────────────────────────────────────────────────────────────────────────────

/// One row per implementation a proxy has pointed at.
model DeploymentArtifact {
  id              BigInt   @id @default(autoincrement())
  network         String
  contractName    String
  proxy           String
  implementation  String
  /// keccak256 of the implementation runtime bytecode.
  codeHash        String
  gitCommit       String
  arcForgeVersion String
  deployBlock     BigInt
  txHash          String
  /// Full deployment JSON entry.
  manifest        Json
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([network, contractName, implementation])
  @@index([network, proxy])
}

/// A KryonTimelock operation (`CallScheduled` / `CallExecuted` / `Cancelled`).
model GovernanceOperation {
  network         String
  /// bytes32 operation id (hashOperation / hashOperationBatch).
  operationId     String
  predecessor     String
  salt            String
  /// [{ target, value, data }] in batch order.
  calls           Json
  delaySeconds    BigInt
  readyAt         DateTime
  status          GovernanceOperationStatus @default(SCHEDULED)
  description     String?
  scheduledTxHash String
  executedTxHash  String?
  cancelledTxHash String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@id([network, operationId])
  @@index([network, status, readyAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  PORTFOLIO
// ─────────────────────────────────────────────────────────────────────────────

/// Vault `Deposited` / `Withdrawn` / `InternalTransfer`. An internal transfer
/// produces two rows from one log (TRANSFER_OUT and TRANSFER_IN).
model BalanceChange {
  id             BigInt            @id @default(autoincrement())
  network        String
  address        String
  kind           BalanceChangeKind
  /// Payer (deposit), recipient (withdrawal) or the other side of a transfer.
  counterparty   String?
  /// Token amount for deposits and withdrawals, 1e6; null for transfers.
  amount         Decimal?          @db.Decimal(78, 0)
  internalAmount Decimal           @db.Decimal(78, 0) // 1e18, always positive
  /// bytes32 reason for internal transfers.
  reason         String?
  blockNumber    BigInt
  txHash         String
  logIndex       Int
  createdAt      DateTime          @default(now())

  @@unique([network, txHash, logIndex, address, kind])
  @@index([network, address, createdAt])
}

/// Realized-pnl events. Summing them reconstructs an account's realized curve.
/// One log can produce several rows (e.g. a liquidation's pnl and penalty).
model PnlEvent {
  id          BigInt       @id @default(autoincrement())
  network     String
  address     String
  marketId    Int
  kind        PnlEventKind
  amount      Decimal      @db.Decimal(78, 0) // 1e18, signed (positive = credit)
  size        Decimal      @default(0) @db.Decimal(78, 0) // 1e18
  price       Decimal      @default(0) @db.Decimal(78, 0) // 1e18
  blockNumber BigInt
  txHash      String
  logIndex    Int
  createdAt   DateTime     @default(now())

  @@unique([network, txHash, logIndex, address, kind])
  @@index([network, address, createdAt])
  @@index([network, marketId, kind])
}

// ─────────────────────────────────────────────────────────────────────────────
//  ANALYTICS (1e6 USDC units, derived; safe to truncate and rebuild)
// ─────────────────────────────────────────────────────────────────────────────

model TraderStat {
  network          String
  address          String
  period           StatsPeriod
  /// Inclusive start of the rolling window (UTC). For ALL this is the epoch.
  periodStart      DateTime
  realizedPnl      Decimal     @default(0) @db.Decimal(78, 0) // 1e6 signed
  volume           Decimal     @default(0) @db.Decimal(78, 0) // 1e6 notional
  tradeCount       Int         @default(0)
  winningTrades    Int         @default(0)
  losingTrades     Int         @default(0)
  winRate          Decimal     @default(0) @db.Decimal(10, 4) // 0..1
  roi              Decimal     @default(0) @db.Decimal(20, 4) // signed ratio
  feesPaid         Decimal     @default(0) @db.Decimal(78, 0) // 1e6
  fundingPaid      Decimal     @default(0) @db.Decimal(78, 0) // 1e6 signed
  liquidationCount Int         @default(0)
  liquidatedVolume Decimal     @default(0) @db.Decimal(78, 0) // 1e6
  peakEquity       Decimal     @default(0) @db.Decimal(78, 0) // 1e6, ROI denominator
  referralCount    Int         @default(0)
  referralVolume   Decimal     @default(0) @db.Decimal(78, 0) // 1e6
  lastTradeAt      DateTime?
  updatedAt        DateTime    @default(now()) @updatedAt
  createdAt        DateTime    @default(now())

  @@id([network, address, period])
  @@index([network, period, realizedPnl])
  @@index([network, period, volume])
  @@index([network, period, roi])
}

/// Point-in-time ranked leaderboard.
model LeaderboardSnapshot {
  id          BigInt      @id @default(autoincrement())
  network     String
  period      StatsPeriod
  metric      String
  capturedAt  DateTime    @default(now())
  /// Ordered [{ rank, address, value, pnl, volume, roi, winRate }], 1e6 strings.
  rankings    Json
  traderCount Int         @default(0)

  @@index([network, period, metric, capturedAt])
}

model PortfolioSnapshot {
  id                BigInt   @id @default(autoincrement())
  network           String
  address           String
  equity            Decimal  @default(0) @db.Decimal(78, 0) // 1e6
  collateral        Decimal  @default(0) @db.Decimal(78, 0) // 1e6
  unrealizedPnl     Decimal  @default(0) @db.Decimal(78, 0) // 1e6 signed
  realizedPnlCum    Decimal  @default(0) @db.Decimal(78, 0) // 1e6 signed
  freeCollateral    Decimal  @default(0) @db.Decimal(78, 0) // 1e6
  initialMargin     Decimal  @default(0) @db.Decimal(78, 0) // 1e6
  maintenanceMargin Decimal  @default(0) @db.Decimal(78, 0) // 1e6
  openPositionCount Int      @default(0)
  longExposure      Decimal  @default(0) @db.Decimal(78, 0) // 1e6 notional
  shortExposure     Decimal  @default(0) @db.Decimal(78, 0) // 1e6 notional
  liquidatable      Boolean  @default(false)
  capturedAt        DateTime @default(now())

  @@index([network, address, capturedAt])
}

model AccountAnalytics {
  network          String
  address          String
  realizedPnlAll   Decimal   @default(0) @db.Decimal(78, 0) // 1e6 signed
  volumeAll        Decimal   @default(0) @db.Decimal(78, 0) // 1e6
  volume30d        Decimal   @default(0) @db.Decimal(78, 0) // 1e6, drives fee tiers
  tradeCountAll    Int       @default(0)
  winRateAll       Decimal   @default(0) @db.Decimal(10, 4)
  totalDeposited   Decimal   @default(0) @db.Decimal(78, 0) // 1e6
  totalWithdrawn   Decimal   @default(0) @db.Decimal(78, 0) // 1e6
  totalFundingPaid Decimal   @default(0) @db.Decimal(78, 0) // 1e6 signed
  totalFeesPaid    Decimal   @default(0) @db.Decimal(78, 0) // 1e6
  liquidationCount Int       @default(0)
  maxDrawdown      Decimal   @default(0) @db.Decimal(78, 0) // 1e6
  firstTradeAt     DateTime?
  lastTradeAt      DateTime?
  updatedAt        DateTime  @default(now()) @updatedAt

  @@id([network, address])
}

// ─────────────────────────────────────────────────────────────────────────────
//  MONITOR (client/lib/monitor)
// ─────────────────────────────────────────────────────────────────────────────

/// Latest monitor tick per network: what the status page reads. Upserted, so
/// it stays one row per network however long the monitor runs.
model MonitorStatus {
  network        String       @id
  level          MonitorLevel
  /// Every check's last result: [{ key, check, subject, status, severity, detail, values, runbook }].
  checks         Json         @default("[]")
  /// Alerts currently firing: [{ key, severity, detail, since }].
  firing         Json         @default("[]")
  tickAt         DateTime
  tickDurationMs Int          @default(0)
  updatedAt      DateTime     @updatedAt
}

/// One row per alert transition. Append-only, but written only when an alert
/// fires, is re-notified or resolves — never once per tick.
model MonitorAlert {
  id        BigInt            @id @default(autoincrement())
  network   String
  /// `<check>` or `<check>:<subject>`.
  alertKey  String
  check     String
  subject   String?
  severity  MonitorSeverity
  event     MonitorAlertEvent
  detail    String
  values    Json              @default("{}")
  runbook   String?
  /// How long it had been failing when this row was written.
  forSecs   Int               @default(0)
  createdAt DateTime          @default(now())

  @@index([network, createdAt])
  @@index([network, alertKey, createdAt])
}

client/scripts/_loadtest_*_keys.json
client/scripts/_loadtest_*wallets*.json
client/scripts/_loadtest_*_state.json
client/scripts/_loadtest_*_minted.json
client/scripts/_drill_wallets.json
client/scripts/_drill_state.json
client/kryon-web.tar.gz
client/logs/
client/.wrangler/
client/.vercel/
.wrangler/
.vercel/
.dev.vars*

# Secrets anywhere in the tree. Arc keys never live in the repo.
*secrets*.env
*.secrets
*.keystore
keystore/
keystores/
*.pem
*.key

# arc-foundry build output and local broadcast state
kryon-protocol/evm/out/
kryon-protocol/evm/cache/
kryon-protocol/evm/broadcast/*/31337/
kryon-protocol/evm/broadcast/**/dry-run/

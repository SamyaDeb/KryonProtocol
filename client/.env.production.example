# USDT0 collateral. Mainnet's addresses are baked into config/networks.ts;
# testnet has no USDT0 issuance of its own, so point these at a mock issued
# with scripts/deploy-testnet-usdt0.ts. Unset = this venue offers no USDT0.
NEXT_PUBLIC_ASSET_USDT0_TESTNET=
NEXT_PUBLIC_USDT0_ISSUER_TESTNET=

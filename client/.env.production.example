# Build-time environment for the web tier — copy to .env.production.local and
# fill in. Used by ship-web-tier.sh when it runs `next build` on YOUR machine.
#
# Everything NEXT_PUBLIC_* here is inlined into the browser bundle by static
# textual substitution at build time. It is therefore the BUILD machine's env
# that reaches users, not the server's — which is why this file exists separately
# from the .env.local that lives on the box.
#
# Next loads .env.production.local ahead of .env.local, so these win over your
# local testnet development values.

NEXT_PUBLIC_STELLAR_NETWORK=mainnet
NEXT_PUBLIC_APP_URL=https://kryonprotocol.live

# Declare each venue honestly. Unset falls back to "only the primary network is
# live", which mislabels the other venue in whichever direction is wrong.
NEXT_PUBLIC_MAINNET_KEEPERS_LIVE=true
NEXT_PUBLIC_TESTNET_KEEPERS_LIVE=false

# One ws-server process tails exactly one database, so each network needs its
# own hostname. These also become the CSP connect-src allowlist.
NEXT_PUBLIC_WS_URL_MAINNET=wss://ws.kryonprotocol.live
NEXT_PUBLIC_WS_URL_TESTNET=wss://ws-testnet.kryonprotocol.live
NEXT_PUBLIC_WS_URL=

# MAINNET IS SINGLE-MARKET. Verified 2026-08-23: the mainnet database holds one
# Market row (XLM-PERP) and the other seven are not registered on chain. On-chain
# registration needs governance proposals against
# CBZT5HUXI42TD55GGB5Y7OZZ72IT5SN64ONOGDYS2PFQCOWIT4XOA6MU with a 48h MinDelay,
# and none have been queued for mainnet — testnet's were queued 2026-08-22 and
# are executable 2026-08-24. Advertising eight markets here would offer traders
# seven that cannot accept an order.
# Restore the full list once add-market.ts --all --execute has run on mainnet.
NEXT_PUBLIC_ACTIVE_MARKETS=XLM-PERP

# Mainnet chain + contracts (see client/.env.mainnet for the authoritative set)
NEXT_PUBLIC_STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_STELLAR_PASSPHRASE=Public Global Stellar Network ; September 2015
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_CONTRACT_GOVERNANCE=CDSIEH7UZ62BT523G3RGJQGJHE7AI4EV265ESKZB672GTIEZNBYPYDXU
NEXT_PUBLIC_CONTRACT_ORACLE_ADAPTER=CD3ZFYZPLJ6W2KO6HD7HE5P5Q27M5N6ITUPHQDRP23NBIVKE6WTUY25F
NEXT_PUBLIC_CONTRACT_VAULT=CDXGTJQS3XLGXSWDUHKMS5PBBFRRKRXRWH3HTBFNXBIAYEZNDTDKLR4J
NEXT_PUBLIC_CONTRACT_ENGINE=CD6OMHCRDDBDO7I57HCUU52RORFPP7DUIRULWFBOX5WLCO5H2OB3W6LZ
NEXT_PUBLIC_CONTRACT_ORDER_GATEWAY=CBA2PSRHSIFTSUAFZWMF6CARNO7YR52PWLWLEXYVRACORS2RXNO2DUTJ
NEXT_PUBLIC_CONTRACT_INSURANCE=CCBEJ3F2PUV5OA4JNX3CPSOJFQMYMFDPLNANR2GJZVQEEBFMB6JYNL54
NEXT_PUBLIC_CONTRACT_LIQUIDATION=CBGSXCZTZOSBMM5RLGZWWLE2USNAXL5ZKCHTZQ6DOKBD3PIEUJXFYDRO
NEXT_PUBLIC_CONTRACT_RISK=CBHZWEIKXULFIH6DCSS7W6BJ3YUVQ5TJFYPP4UKQC4NKLNAF7VLPNVUI
NEXT_PUBLIC_ASSET_NATIVE_XLM=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA

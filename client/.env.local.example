# Local development. Copy to .env.local and fill in values. Never commit the copy.
# Names only; no values are provided on purpose.

# ── Network ─────────────────────────────────────────────────────────────────
# One of: arc-mainnet | arc-testnet | arc-local   (read by lib/chain/networks.ts)
KRYON_NETWORK=
# Comma-separated provider RPC URLs, tried in order; the public RPC is appended last.
ARC_RPC_URLS=
# Path to a deployment record written by kryon-protocol/evm/script
# (evm/deployments/<network>.json). When set, the CONTRACT_* variables are ignored.
KRYON_DEPLOYMENT_FILE=

# ── Contract addresses (only if KRYON_DEPLOYMENT_FILE is unset) ─────────────
CONTRACT_VAULT=
CONTRACT_ENGINE=
CONTRACT_ORDER_GATEWAY=
CONTRACT_ORACLE_ADAPTER=
CONTRACT_LIQUIDATION=
CONTRACT_INSURANCE=
CONTRACT_RISK_PARAMS=
CONTRACT_FEE_ROUTER=
CONTRACT_TIMELOCK=

# ── Database (server-side only) ─────────────────────────────────────────────
# e.g. postgresql://USER:PASSWORD@HOST:5432/kryon?sslmode=require
DATABASE_URL=
DIRECT_URL=

# ── Public URLs ─────────────────────────────────────────────────────────────
# e.g. https://app.<APP_DOMAIN> and wss://ws.<APP_DOMAIN>
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_WS_URL=

# ── Service keys ────────────────────────────────────────────────────────────
# Each Arc service loads its own 32-byte hex key with serviceAccount(<VAR>)
# (lib/chain/clients.ts). No Arc service is wired yet; the variable names are
# added here as each service is ported. Never share a key between services.

# ── LEGACY (removed in Phase 3/4) ───────────────────────────────────────────
# Still read by legacy chain code (lib/stellar/**, config/, older scripts) so
# local builds keep working. Do not add new uses.
DATABASE_URL_MAINNET=
DATABASE_URL_TESTNET=
NEXT_PUBLIC_STELLAR_NETWORK=
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_STELLAR_PASSPHRASE=
NEXT_PUBLIC_STELLAR_HORIZON_URL=
NEXT_PUBLIC_ACTIVE_MARKETS=
NEXT_PUBLIC_CONTRACT_GOVERNANCE=
NEXT_PUBLIC_CONTRACT_ORACLE_ADAPTER=
NEXT_PUBLIC_CONTRACT_VAULT=
NEXT_PUBLIC_CONTRACT_ENGINE=
NEXT_PUBLIC_CONTRACT_ORDER_GATEWAY=
NEXT_PUBLIC_CONTRACT_INSURANCE=
NEXT_PUBLIC_CONTRACT_LIQUIDATION=
NEXT_PUBLIC_CONTRACT_RISK=
NEXT_PUBLIC_ASSET_NATIVE_XLM=
NEXT_PUBLIC_ASSET_USDC=
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_WS_URL_MAINNET=
NEXT_PUBLIC_WS_URL_TESTNET=
NEXT_PUBLIC_MAINNET_KEEPERS_LIVE=
NEXT_PUBLIC_TESTNET_KEEPERS_LIVE=
ORACLE_PUBLISHER_SECRET=
MATCHER_OPERATOR_SECRET=
LIQUIDATOR_SECRET=
MATCHER_OPERATOR_SECRET_MAINNET=
MATCHER_OPERATOR_SECRET_TESTNET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SETTLEMENT_JOB_MAX_AGE_MINUTES=
ORACLE_MIN_SOURCES=
ORACLE_MAX_SOURCE_DEVIATION_BPS=
USDC_DEPEG_HALT_BPS=
LIQUIDATION_INTERVAL_MS=
LIQUIDATION_MAX_ACCOUNTS=
WS_PORT=
ALERT_WEBHOOK_URL=
REFLECTOR_GUARD_ENABLED=
REFLECTOR_DIVERGENCE_HALT_BPS=
REFLECTOR_MAX_AGE_SECS=
REFLECTOR_CONTRACT_ID=
PUBLISH_STAGGER_MS=

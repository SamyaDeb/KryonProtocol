# Shared by every service in docker-compose.yml. Names only; no secrets here
# beyond the database URL, which the secret manager should inject.
KRYON_NETWORK=
DATABASE_URL=
# At least two provider URLs off arc-local (lib/config-check.ts).
ARC_RPC_URLS=
# Mounted read-only at /app/deployments.
KRYON_DEPLOYMENT_FILE=/app/deployments/
KRYON_KMS_REGION=
LOG_LEVEL=

# ─────────────────────────────────────────────────────────────────────────────
# Kryon TESTNET keeper fleet — copy to .env.testnet and fill in.
#
# Consumed by ecosystem.testnet.config.cjs (pm2 start ecosystem.testnet.config.cjs).
# This file configures the KEEPER PROCESSES only. The web app does not read it;
# its testnet addresses are baked into config/networks.ts and its database
# routing comes from DATABASE_URL_TESTNET in the app's own env.
#
# chmod 600 .env.testnet — it holds funded Stellar secret keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# Pins every script in this fleet to testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_ACTIVE_MARKETS=XLM-PERP,BTC-PERP,ETH-PERP,SOL-PERP,XRP-PERP,ADA-PERP,BNB-PERP,TRX-PERP

# ── Database ─────────────────────────────────────────────────────────────────
# The testnet database — NEVER point this at kryon_mainnet.
DATABASE_URL=postgresql://kryon:PASSWORD@127.0.0.1:5432/kryon_testnet
DIRECT_URL=postgresql://kryon:PASSWORD@127.0.0.1:5432/kryon_testnet

# ── Contracts (testnet, redeployed 2026-07-05) ───────────────────────────────
# These match the baked testnet defaults in config/networks.ts. If you redeploy
# the testnet contracts, update BOTH this file and config/networks.ts.
NEXT_PUBLIC_CONTRACT_GOVERNANCE=CBZT5HUXI42TD55GGB5Y7OZZ72IT5SN64ONOGDYS2PFQCOWIT4XOA6MU
NEXT_PUBLIC_CONTRACT_ORACLE_ADAPTER=CARSV4BT3II5QONUAOP4D363OUNTTSSZCXSKNNXKZCBJM7Z6UXSNZ3LP
NEXT_PUBLIC_CONTRACT_VAULT=CBQ6634Z3UPXFVVHHV2JNSGXHQOZZK62Z65HCAQTINBGXS3IDXKRTRYK
NEXT_PUBLIC_CONTRACT_ENGINE=CBSUYAO2EYAQVFISJQKG4TNMJPCDCPPFGI25Q3SW2BJPFSKQ45GRGTXN
NEXT_PUBLIC_CONTRACT_ORDER_GATEWAY=CAJGC2SIV6DFJETJ6ATG5MR6RPNX5HQ26LYA4RGSHF2QPTBS6OJWONL3
NEXT_PUBLIC_CONTRACT_INSURANCE=CA3VD55APWCYLVN7PYGJ7NPKSQBE3VU4MWVCSKLOYAZI5RFWWR76G2CL
NEXT_PUBLIC_CONTRACT_LIQUIDATION=CDCRNKXTTTOO7IRVC66KZR5QMVGGZIOF2QPJSVELLD7G7F4IVLM2DCMG
NEXT_PUBLIC_CONTRACT_RISK=CAVCW7XCQRA6VYWBKFDABYZGDNUJYHEYKHR4TT6BQBHS6QPDGFJVYBDS

NEXT_PUBLIC_ASSET_NATIVE_XLM=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_ASSET_USDC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── Operator secrets ─────────────────────────────────────────────────────────
# THREE DISTINCT funded testnet accounts — one role per key. None may be the
# contract admin, and none may be reused from the mainnet fleet: a shared key
# means the two fleets race the same Stellar sequence number and both start
# failing with TxBadSeq. Fund each with friendbot.
ORACLE_PUBLISHER_SECRET=
MATCHER_OPERATOR_SECRET=
LIQUIDATOR_SECRET=

# Funding keeper: a fourth distinct funded account, permissionless-called but
# still needs XLM for fees. Without this running, update_funding is never
# called and no position ever pays or receives funding (audit KRY-Q2).
FUNDING_KEEPER_SECRET=
# FUNDING_INTERVAL_MS=900000

# ── Oracle keeper ────────────────────────────────────────────────────────────
# REQUIRED. `write_price` rejects a publish_time ahead of the last closed
# ledger's timestamp (StaleOracle, Error(Contract, #6)), and during simulation
# that timestamp trails wall clock by up to a full ledger. Testnet exhibits this
# exactly as mainnet does — an unset/zero backdate means EVERY publish fails
# silently and the venue looks alive but never prices.
PUBLISH_TIME_BACKDATE_SECS=15

# Eight markets are eight separate write_price transactions on one publisher
# account; stagger them so consecutive submissions don't race the sequence.
PUBLISH_STAGGER_MS=400

# ORACLE_MIN_SOURCES=2
# ORACLE_MAX_SOURCE_DEVIATION_BPS=200
# USDC_DEPEG_HALT_BPS=100

# ── Monitor alerting ─────────────────────────────────────────────────────────
# Strongly recommended: without a webhook a dead testnet fleet is silent, which
# is how the 2026-07 mainnet outage went unnoticed for 43 days.
# ALERT_WEBHOOK_URL=

# ── Settlement reconciler ────────────────────────────────────────────────────
SETTLEMENT_JOB_MAX_AGE_MINUTES=15

# Arc testnet services. Copy to .env.testnet and fill in values (KRYON_NETWORK=arc-testnet).
# Names only; no values are provided on purpose.

# ── Network ─────────────────────────────────────────────────────────────────
# One of: arc-mainnet | arc-testnet | arc-local   (read by lib/chain/networks.ts)
KRYON_NETWORK=
# Comma-separated provider RPC URLs, tried in order; the public RPC is appended
# last. At least TWO are required off arc-local, so one provider outage is not
# an outage (lib/config-check.ts).
ARC_RPC_URLS=
# Path to a deployment record written by kryon-protocol/evm/script
# (evm/deployments/<network>.json). When set, the CONTRACT_* variables are ignored.
KRYON_DEPLOYMENT_FILE=

# ── Contract addresses (only if KRYON_DEPLOYMENT_FILE is unset) ─────────────
CONTRACT_VAULT=
CONTRACT_ENGINE=
CONTRACT_ORDER_GATEWAY=
CONTRACT_ORACLE_ADAPTER=
CONTRACT_LIQUIDATION=
CONTRACT_INSURANCE=
CONTRACT_RISK_PARAMS=
CONTRACT_FEE_ROUTER=
CONTRACT_TIMELOCK=

# ── Database (server-side only) ─────────────────────────────────────────────
# e.g. postgresql://USER:PASSWORD@HOST:5432/kryon?sslmode=require
DATABASE_URL=
DIRECT_URL=

# ── Public URLs ─────────────────────────────────────────────────────────────
# e.g. https://app.<APP_DOMAIN> and wss://ws.<APP_DOMAIN>
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_WS_URL=

# ── Web app (the Next process; NEXT_PUBLIC_* are inlined into the bundle) ───
# The venue this deployment serves, and the venues its network toggle offers.
# KRYON_NETWORK and NEXT_PUBLIC_KRYON_NETWORK must agree (lib/config-check.ts),
# so a UI can never point at a different venue than its own API.
NEXT_PUBLIC_KRYON_NETWORK=
# Comma separated; unset means the primary network only. Never offer arc-local
# next to a public network.
NEXT_PUBLIC_KRYON_NETWORKS=
# Public WebSocket for this venue (wss://ws.<APP_DOMAIN>). Unset makes the UI
# fall back to REST polling.
NEXT_PUBLIC_WS_URL_ARC_TESTNET=
# "true" once the keepers run behind this venue; otherwise the UI shows the
# degraded-venue banner.
NEXT_PUBLIC_ARC_TESTNET_KEEPERS_LIVE=
# WalletConnect Cloud project id. Without it the WalletConnect and Ledger
# options are hidden; injected and Coinbase wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Rate limiting (lib/rate-limit.ts). REQUIRED in production: without these the
# limiter denies every API request, so the venue answers 429 to everything.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Jurisdictions to block, ISO 3166-1 alpha-2, comma separated (proxy.ts).
# Empty blocks nothing. Needs a CDN that sets cf-ipcountry or
# x-vercel-ip-country in front of the app.
KRYON_BLOCKED_COUNTRIES=

# ── Service keys ────────────────────────────────────────────────────────────
# Each Arc service signs with its own key; never share a key between services,
# or between two processes of one service (the nonce belongs to the key).
# Where a role's key lives is set by KRYON_SIGNER_<ROLE> (lib/chain/signer.ts,
# kryon-protocol/infra/signers/README.md); the role is the key variable minus
# _PRIVATE_KEY / _KEY (MATCHER_OPERATOR_KEY -> MATCHER_OPERATOR):
#   kms:<keyId|alias/...>  AWS KMS ECC_SECG_P256K1 key (required on mainnet)
#   keystore               JSON v3 file at KRYON_KEYSTORE_<ROLE>, passphrase in
#                          KRYON_KEYSTORE_<ROLE>_PASSPHRASE_FILE (or _PASSPHRASE)
#   env                    raw hex in the key variable below; arc-local only
#                          (arc-testnet also needs KRYON_ALLOW_ENV_SIGNER=arc-testnet)
# Unset is an error off arc-local. The raw *_KEY variables below are read in
# env mode only; leave them empty with kms or keystore.
KRYON_SIGNER_MATCHER_OPERATOR=
KRYON_SIGNER_ORACLE_PUBLISHER=
KRYON_SIGNER_FUNDING_KEEPER=
KRYON_SIGNER_LIQUIDATOR=
KRYON_SIGNER_REFILL_FUNDER=
KRYON_SIGNER_FEE_TIER_BOT=
KRYON_SIGNER_BACKSTOP_SIGNER=
# Optional: KMS region (SDK default otherwise), per-call timeout and retries.
KRYON_KMS_REGION=
KRYON_KMS_TIMEOUT_MS=
KRYON_KMS_RETRIES=

# ── Oracle publisher (scripts/oracle-keeper.ts) ─────────────────────────────
# Cadence is the venue's largest running cost: every push is a transaction.
# Feeds backing a market that is listed but closed cannot be traded against,
# so they are published on a cheaper schedule — fresh enough to quote and to
# list a market from, but not paid for at trading speed. "false" prices every
# feed at trading speed, as before. All optional; see the script's header.
ORACLE_IDLE_CADENCE=
ORACLE_IDLE_DEVIATION_BPS=
ORACLE_IDLE_HEARTBEAT_SECS=
ORACLE_MARKETS_TTL_MS=

# ── Indexer (scripts/state-indexer.ts) ──────────────────────────────────────
# Deployment block; used only when no cursor exists yet.
INDEXER_START_BLOCK=
# Optional: idle poll interval in ms and max blocks per getLogs (both default 2000).
INDEXER_POLL_MS=
INDEXER_MAX_WINDOW=

# ── Matcher (scripts/matcher-service.ts) ────────────────────────────────────
# One process per shard: one operator key, one set of markets. Two matcher
# processes must never share a key — TxSender owns the nonce for its key.
# Market ids this shard matches, comma separated (e.g. 2,3). Required.
MATCHER_MARKETS=
# 32-byte hex private key holding OPERATOR_ROLE on the gateway.
MATCHER_OPERATOR_KEY=
# Optional: shard name for logs (defaults to the market list).
MATCHER_SHARD=
# Optional: tick interval in ms (default 1000).
MATCHER_INTERVAL_MS=
# Optional: fill count below which an InsufficientBatchGas resize gives up (default 1).
MATCHER_MIN_BATCH_FILLS=
# Optional: ms before recovery judges a pending fill with no TxJob (default 60000).
MATCHER_ORPHAN_GRACE_MS=
# An order the chain refuses waits before being offered again, doubling each
# time, and is parked after enough strikes. Without it the matcher re-offers
# the same fill every tick and pays gas for every rejection.
MATCHER_REJECT_BACKOFF_MS=
MATCHER_REJECT_BACKOFF_MAX_MS=
MATCHER_REJECT_PARK_AFTER=
MATCHER_REJECT_FORGET_MS=
# Optional: port for GET /health; unset disables the endpoint.
MATCHER_HEALTH_PORT=

# ── Backstop unwinder (scripts/backstop-unwinder.ts) ────────────────────────
# Signs reduce-only orders for the Insurance backstop (ERC-1271); sends no
# transactions, needs no gas. Idle until governance sets Insurance unwind
# limits and grants this key BACKSTOP_SIGNER_ROLE. Key custody:
# KRYON_SIGNER_BACKSTOP_SIGNER above. All optional.
BACKSTOP_INTERVAL_MS=
BACKSTOP_ORDER_TTL_SECONDS=
BACKSTOP_PRICE_OFFSET_BPS=
BACKSTOP_MAX_ORDERS_PER_TICK=

# ── Fee-tier bot (scripts/fee-tier-bot.ts) ──────────────────────────────────
# Assigns FeeRouter tiers from 30-day volume. DRY RUN unless
# FEE_TIER_BOT_ENABLED=true. Key custody: KRYON_SIGNER_FEE_TIER_BOT above.
# Schedule: tier:minUsd30d,... (tiers must already be defined by governance).
FEE_TIER_SCHEDULE=
FEE_TIER_BOT_ENABLED=
FEE_TIER_MAX_CHANGES_PER_TICK=
FEE_TIER_MAX_STATS_AGE_MS=
FEE_TIER_INTERVAL_MS=

# WebSocket server (scripts/ws-server.ts). Reads only; no key. KRYON_NETWORK is
# required. Health: GET /healthz on the same port.
WS_PORT=
WS_HOST=
WS_POLL_MS=
WS_MARKETS_POLL_MS=
WS_MAX_CONNECTIONS=
WS_MAX_CHANNELS=
WS_MAX_BUFFERED_BYTES=
WS_PING_INTERVAL_MS=
WS_IDLE_TIMEOUT_MS=
WS_HEALTH_STALE_MS=

# Stats aggregator (scripts/stats-aggregator.ts). Reads only the indexer's
# projections; writes only the analytics tables. No key. KRYON_NETWORK required.
STATS_INTERVAL_MS=
STATS_SNAPSHOT_MS=
STATS_SNAPSHOT_LIMIT=
STATS_BATCH_SIZE=
STATS_REBUILD_HOUR_UTC=
# Alert transport shared by the keepers and the monitor: a Slack, Discord or
# Telegram webhook. Without it, alerts only reach the logs.
ALERT_WEBHOOK_URL=

# Monitor (scripts/monitor.ts). Read-only: it holds NO key and sends NO
# transaction. Names only here, as everywhere in these files.
MONITOR_INTERVAL_MS=
# Alert transport: ALERT_WEBHOOK_URL is above. The format is detected from the
# URL unless ALERT_WEBHOOK_FORMAT says otherwise.
ALERT_WEBHOOK_FORMAT=
ALERT_TELEGRAM_CHAT_ID=
# Delivery discipline: fire after N failing ticks, resolve after M passing
# ones, remind while still failing, and stay quiet for the first grace period.
MONITOR_FAIL_AFTER=
MONITOR_RESOLVE_AFTER=
MONITOR_RENOTIFY_MS=
MONITOR_STARTUP_GRACE_MS=
# /healthz, /metrics (Prometheus) and /status. Port 0 disables the server.
MONITOR_HTTP_HOST=
MONITOR_HTTP_PORT=
# "false" stops the MonitorStatus / MonitorAlert writes.
MONITOR_SNAPSHOT=
# Service keys to watch, name:0xaddress,... Defaults to REFILL_TARGETS, and the
# WARN floor defaults to REFILL_FLOOR_USDC so the two cannot disagree.
MONITOR_GAS_TARGETS=
MONITOR_GAS_WARN_USDC=
MONITOR_GAS_PAGE_USDC=
MONITOR_REFILL_FUNDER_ADDRESS=
# Expected governance state. Without these the monitor says so (at WARN)
# rather than passing: write the role baseline with
# `npx tsx scripts/monitor.ts --print-role-baseline` once 99_VerifyDeployment passes.
MONITOR_ROLE_BASELINE_FILE=
MONITOR_EXPECTED_DEPOSIT_CAP_USDC=
MONITOR_EXPECTED_ACCOUNT_CAP_USDC=
# What else to probe: the app's /api/health and the WS server's ping/pong.
# On one host these are localhost, not the public URLs above.
MONITOR_API_URL=
MONITOR_WS_URL=
MONITOR_REPLICA_DATABASE_URL=
# Thresholds (all optional; see lib/monitor/config.ts for the defaults).
MONITOR_ORACLE_STALE_FRACTION=
MONITOR_ORACLE_DIVERGENCE_FRACTION=
MONITOR_ORACLE_FLATLINE_SECS=
MONITOR_INSURANCE_COVERAGE_MIN_BPS=
MONITOR_DEPOSIT_UTILIZATION_WARN_BPS=
MONITOR_INDEXER_LAG_SECS=
MONITOR_INDEXER_LAG_BLOCKS=
MONITOR_CROSSED_BOOK_SECS=
MONITOR_PENDING_FILL_SECS=
MONITOR_TXJOB_STUCK_SECS=
MONITOR_REJECTION_WINDOW_SECS=
MONITOR_REJECTION_RATE_MAX_BPS=
MONITOR_REJECTION_MIN_SAMPLE=
MONITOR_FUNDING_STALE_SECS=
MONITOR_LIQUIDATION_BATCH=
MONITOR_FEES_GAS_MIN_USDC=
MONITOR_BACKSTOP_WARN_USDC=
MONITOR_RPC_LATENCY_WARN_MS=
MONITOR_DB_LATENCY_WARN_MS=
MONITOR_REPLICA_LAG_SECS=
